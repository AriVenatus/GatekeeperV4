# Fallback secrets loading via environment variables / a local .env file.
# Used only if tokens.py does not exist (see tokenstemplate.py for the primary method).
# Copy this file to .env and fill in the values, or export these as real environment
# variables (e.g. via systemd EnvironmentFile= or a secret manager). .env is gitignored.

#Discord Server Connection Bot Token (Under Bot request token)
GATEKEEPER_TOKEN=

#2Factor AUTH Code for AMP Console Login
#Leave blank if you are not using 2FA.
GATEKEEPER_AMP_AUTH=

#Login creds - ## DO NOT SHARE! ##
#GATEKEEPER_AMP_USER is the Login Name for the account you want the bot to use.
#GATEKEEPER_AMP_PASSWORD is the password for said Login.
#GATEKEEPER_AMP_URL is the local URL to your web gui (eg. http://192.168.3.500:8080)
GATEKEEPER_AMP_USER=
GATEKEEPER_AMP_PASSWORD=
GATEKEEPER_AMP_URL=

#Steam Web API Key, used for `/link steam` account previews (avatar/name lookup).
#Get a free key at https://steamcommunity.com/dev/apikey
#Leave blank to disable Steam account linking.
GATEKEEPER_STEAM_API_KEY=
